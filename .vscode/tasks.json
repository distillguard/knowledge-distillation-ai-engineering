{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dolly: 모델별 학습·평가",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-u", "-B", "-X", "utf8",
        "${workspaceFolder}/scripts/run_dolly_sft.py",
        "--model", "${input:dollyModel}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "dollyModel",
      "type": "pickString",
      "description": "실행할 모델 또는 전체 순차 실행. 기존 학습 중에는 중복 실행이 차단됩니다.",
      "options": [
        "all", "gpt2_base", "gpt2_xl",
        "opt_125m", "opt_27b", "openllama_3b", "openllama_7b",
        "gemma2_2b_it", "gemma2_9b_it"
      ],
      "default": "all"
    }
  ]
}
