# Local source downloads, datasets, model caches and training artifacts.
.sources/
tmp/
.cache/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Credentials and machine-specific editor settings.
.env
.env.*
.hf_token
.vscode/settings.json

# Large weights/checkpoints belong in local storage; summary JSON/CSV/PNG stay public.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
**/checkpoint-*/
**/best_adapter/
*.log
*.tmp
*.lock

# Volatile progress and per-chat notification receipts.
results/**/*_progress.json
results/**/worker_status.json
results/**/reported_completions.json
