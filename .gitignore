# Local source downloads, datasets, model caches and training artifacts.
.sources/
tmp/
.cache/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Credentials and machine-specific editor settings.
.env
.env.*
.hf_token
.vscode/settings.json

# Large weights/checkpoints belong in local storage; summary JSON/CSV/PNG stay public.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
**/checkpoint-*/
**/best_adapter/
*.log
*.tmp
*.lock

# Volatile progress and per-chat notification receipts.
results/**/*_progress.json
results/**/worker_status.json
results/**/reported_completions.json

# Public tree: the current GPT-2 soft-gate study only. Historical files stay local.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/requirements-sft.txt
!/requirements-supplementary-metrics.txt
!/docs/
!/scripts/
!/tests/
!/results/

/docs/*
!/docs/RESEARCH_PLAN_SOFT_GATE_GRADIENT.md
!/docs/GPT2_AI_ENGINEERING.md
!/docs/SOFT_GATE_PROGRESS.md
!/docs/SOFT_GATE_STUDENT_PROGRESS.md

/scripts/*
!/scripts/soft_gate_study.py
!/scripts/run_soft_gate_stage1.py
!/scripts/train_soft_gate_student.py
!/scripts/score_soft_gate_baselines.py
!/scripts/prepare_soft_gate_assets.py
!/scripts/dolly_sft.py
!/scripts/dolly_study.py
!/scripts/evaluate_dolly_sft.py
!/scripts/prepare_supplementary_metrics.py
!/scripts/evaluate_supplementary_metrics.py
!/scripts/supplementary_metrics.py

/tests/*
!/tests/test_soft_gate_study.py
!/tests/test_soft_gate_student.py

/results/*
!/results/soft_gate_gradient_v1/
!/results/dolly_sft_v1/
/results/dolly_sft_v1/*
!/results/dolly_sft_v1/evaluation_preflight.json
!/results/supplementary_metrics_v1/
/results/supplementary_metrics_v1/*
!/results/supplementary_metrics_v1/assets.json
