# Publish only the completed ECQA study and its aggregate evidence.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/RESEARCH_PLAN.md
!/RESEARCH_REPORT.md
!/RESULTS_VISUALIZATION.md
!/requirements.txt
!/docs/
/docs/*
!/docs/ABSTRACT_KO.md
!/docs/NOTATION.md
!/docs/PAPER_KO.md
!/scripts/
/scripts/*
!/scripts/analyze_ecqa_kd.py
!/scripts/audit_ecqa_ce.py
!/scripts/ecqa_study.py
!/scripts/gpu_safety.py
!/scripts/kd_ecqa.py
!/scripts/render_results.py
!/scripts/sft_ecqa.py
!/tests/
/tests/*
!/tests/test_ecqa_ce.py
!/tests/test_ecqa_kd.py
!/tests/test_ecqa_study.py
!/artifacts/
/artifacts/*
!/artifacts/ecqa/
/artifacts/ecqa/**
!/artifacts/ecqa/**/
!/artifacts/ecqa/**/*.json
!/artifacts/ecqa/figures/*.png
!/artifacts/ecqa/figures/*.svg
!/artifacts/ecqa/kd/figures/*.png
!/artifacts/ecqa/kd/figures/*.svg

# Keep duplicate metric histories and operational records local.
/artifacts/ecqa/**/history.json
/artifacts/ecqa/**/*_history.json
/artifacts/ecqa/**/training.json
/artifacts/ecqa/**/*_training.json
/artifacts/ecqa/kd/interpretation_update.json
/artifacts/ecqa/kd/initial_training_verification.json
/artifacts/ecqa/kd/compute_memory_recovery.json

# Private data, archives, model weights, responses and machine settings.
**/local/
**/raw/
**/responses/
**/logs/
**/source_snapshot/
**/run_source/
**/recovery/
**/output/
**/tmp/
**/.env
**/.env.*
**/.hf_token
**/.vscode/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.log
**/*.tmp
**/*.lock
**/*.hwp
**/*.hwpx
**/*.hml
**/*.pdf
**/*.pem
**/*.key
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
**/checkpoint-*/

# The user-approved conference manuscript is the only published HWP.
!/docs/dcs인공지능공학논문.hwp
